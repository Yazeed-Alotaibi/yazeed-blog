.DS_Store
Thumbs.db
*.log
.env
.env.*
!.env.example
node_modules/

# Claude Code's per-machine permission overrides. The shared allowlist lives in
# .claude/settings.json and is committed; this one is personal to a checkout
# and committing it would push one person's approvals onto everyone else.
.claude/settings.local.json

# Python bytecode, generated when a vendored skill script runs
__pycache__/
*.py[cod]

# The seeded design canvas: ~2.5 MB of editor payload wrapped around the
# .dc.html sources beside it. Regenerate it with the design skill's
# seed-canvas.mjs rather than tracking the build output.
design/archive/calculation-desk.html
